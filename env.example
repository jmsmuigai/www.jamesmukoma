# AURA Intelligence Portfolio - Environment Configuration

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
VITE_APP_NAME=AURA Intelligence
VITE_APP_VERSION=2.0.0

# ===========================================
# API CONFIGURATION
# ===========================================
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# ===========================================
# AI SERVICES
# ===========================================
# Google Gemini API Key (Required for chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# ===========================================
# MAPBOX CONFIGURATION
# ===========================================
# Mapbox Access Token (Required for maps)
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
MAPBOX_STYLE_URL=mapbox://styles/mapbox/satellite-v9

# ===========================================
# GOOGLE EARTH ENGINE
# ===========================================
# Earth Engine Service Account (Optional)
EARTH_ENGINE_SERVICE_ACCOUNT=your-ee-service-account@project.iam.gserviceaccount.com
EARTH_ENGINE_PRIVATE_KEY_PATH=path/to/ee-private-key.json

# ===========================================
# PAYMENT INTEGRATION (M-PESA)
# ===========================================
# M-Pesa API Credentials
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_BUSINESS_SHORT_CODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payment/callback
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB (Optional - for production)
MONGODB_URI=mongodb://localhost:27017/aura_intelligence
MONGODB_DATABASE=aura_intelligence

# PostgreSQL (Optional - for production)
DATABASE_URL=postgresql://username:password@localhost:5432/aura_intelligence

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
SECRET_KEY=your-super-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aura-intelligence.com

# ===========================================
# FILE STORAGE
# ===========================================
# Google Cloud Storage
GCS_BUCKET_NAME=aura-intelligence-assets
GCS_PROJECT_ID=your-gcp-project-id

# Local storage (for development)
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=16777216

# ===========================================
# ANALYTICS & MONITORING
# ===========================================
# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry (Error tracking)
VITE_SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
FLASK_DEBUG=true
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Uncomment and configure for production
# FLASK_DEBUG=false
# FLASK_ENV=production
# PORT=8080

# ===========================================
# DEPLOYMENT
# ===========================================
# GitHub Pages
GITHUB_TOKEN=your_github_token_here

# Google Cloud Run
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Vercel (Alternative deployment)
VERCEL_TOKEN=your_vercel_token_here

# ===========================================
# FEATURE FLAGS
# ===========================================
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_3D_GRAPHICS=true
VITE_ENABLE_VOICE_INPUT=true

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Calendly (for booking meetings)
CALENDLY_API_KEY=your_calendly_api_key
CALENDLY_USER_URL=https://calendly.com/your-username

# LinkedIn API (for social integration)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ===========================================
# PERFORMANCE & OPTIMIZATION
# ===========================================
VITE_ENABLE_PWA=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_VERSION=1.0.0

# Image optimization
VITE_IMAGE_OPTIMIZATION=true
VITE_WEBP_SUPPORT=true

# ===========================================
# LOCALIZATION
# ===========================================
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,sw

# ===========================================
# NOTIFICATIONS
# ===========================================
# Push notifications
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ===========================================
# BACKUP & RECOVERY
# ===========================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===========================================
# COMPLIANCE & LEGAL
# ===========================================
PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.com/terms
GDPR_COMPLIANCE=true
